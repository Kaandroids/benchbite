{
  "name": "benchbite",
  "version": "0.1.0",
  "packageManager": "pnpm@11.22.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.24",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "i18next": "^26.5.3",
    "intl-pluralrules": "^2.0.1",
    "react": "19.3.0",
    "react-i18next": "^17.1.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "~0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "supabase": "^2.121.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc -p scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:locales": "node scripts/check-locales.ts",
    "import:exercises": "node scripts/import-exercises.ts",
    "icons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-icons.ts",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts && cp src/lib/database.types.ts supabase/functions/_shared/database.types.ts && prettier --write src/lib/database.types.ts supabase/functions/_shared/database.types.ts",
    "functions:check": "cd supabase/functions && deno check . && deno lint && deno test",
    "check:plans": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-plans.ts",
    "test": "jest"
  },
  "private": true
}
