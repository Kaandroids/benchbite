# Copy this file to .env.local, which is ignored by Git, and restart the dev server.
# The defaults point at the local Supabase stack (`pnpm supabase start`); the key is the
# local stack's fixed development key and only works there.
# See "Run the app" in docs/development.md for the URL to use on Android or a physical device.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Where the app reports crashes and errors, from the Sentry project's settings (ADR 0149); not a
# secret. Without it nothing is reported. A development build reports only with
# EXPO_PUBLIC_SENTRY_IN_DEV=1, to try the setup.
EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_SENTRY_IN_DEV=1

# The captcha (ADR 0171): the page that runs Turnstile, and its key. By default the website's page,
# with Cloudflare's test key in development and the production key in a release build. The local
# stack checks no captcha, so these only matter to try the check itself, as against the website
# served from this Mac: EXPO_PUBLIC_CAPTCHA_URL=http://<this Mac's address>:4321/captcha/.
# EXPO_PUBLIC_CAPTCHA_URL=
# EXPO_PUBLIC_TURNSTILE_SITE_KEY=
