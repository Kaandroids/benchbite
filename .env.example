# Copy this file to .env.local, which is ignored by Git, and restart the dev server.
# The defaults point at the local Supabase stack (`pnpm supabase start`); the key is the
# local stack's fixed development key and only works there.
# On a physical device, replace 127.0.0.1 with your computer's IP address on the local network.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
