{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    },
    // Without this, TypeScript loads every installed @types package, including the Node types
    // that only scripts/ should see.
    "types": []
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // Node scripts have their own tsconfig, and Edge Functions are checked by Deno.
  "exclude": ["node_modules", "scripts", "supabase/functions"]
}
