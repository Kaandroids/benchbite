{
  "expo": {
    "name": "Benchbite",
    "slug": "benchbite",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "benchbite",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/ios-icon-dark.png",
        "tinted": "./assets/images/ios-icon-tinted.png"
      },
      "bundleIdentifier": "com.benchbite.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      },
      "appleTeamId": "66LF92GSEG"
    },
    "android": {
      "package": "com.benchbite.app",
      "adaptiveIcon": {
        "backgroundColor": "#FF6A10",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.WRITE_ACTIVE_CALORIES_BURNED"
      ]
    },
    "locales": {
      "en": "./src/i18n/permissions/en.json",
      "de": "./src/i18n/permissions/de.json",
      "tr": "./src/i18n/permissions/tr.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF6A10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#111214",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-localization",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Benchbite uses the photos you choose to show how your own exercises are done, to estimate your meals and to send them to Bite, your coach.",
          "cameraPermission": "Benchbite uses the camera to take photos of how your own exercises are done, of meals to estimate and of what you send to Bite, your coach."
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Benchbite uses the microphone only while you hold to talk to Bite, your coach, to send what you say as a voice message.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Benchbite reads the heart rate and active calories of your workouts, to show how hard they were, and your weight and steps, to keep your progress up to date. It also reads the workouts other apps recorded, to show them next to yours and so that one your watch recorded is not saved twice.",
          "NSHealthUpdateUsageDescription": "When you turn it on, Benchbite saves each workout you finish, with its time and active calories, to Apple Health.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
