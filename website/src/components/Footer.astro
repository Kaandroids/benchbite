---
import Brand from './Brand.astro';
import NightHour from './NightHour.astro';
import { localePath, messagesFor, type Locale, type Page } from '../i18n';

type Props = {
  locale: Locale;
  /** With the last hour of the day, as the landing page ends. Other pages stay quiet. */
  night: boolean;
};

const { locale, night } = Astro.props;
const { footer } = messagesFor(locale);

const links: { page: Page; label: string }[] = [
  { page: 'support', label: footer.support },
  { page: 'delete-account', label: footer.deleteAccount },
  { page: 'privacy', label: footer.privacy },
  { page: 'terms', label: footer.terms },
  { page: 'imprint', label: footer.imprint },
];
---

<footer>
  <div class:list={['content', { night }]}>
    {night && <NightHour locale={locale} />}
    <div class="links">
      {!night && <Brand locale={locale} iconSize={32} />}
      <nav aria-label={footer.links}>
        {links.map((link) => <a href={localePath(locale, link.page)}>{link.label}</a>)}
      </nav>
    </div>
    <div class="small-print">
      <span>{footer.note}</span>
      <span>© 2026 Benchbite</span>
    </div>
  </div>
</footer>

<style>
  footer {
    overflow: hidden;
    background: var(--night);
    --primary-text: var(--brand-light);
    color: var(--on-inverse);
    font-weight: 700;
    line-height: 1.4;
  }

  .content {
    max-width: 1184px;
    margin: 0 auto;
    padding: 32px clamp(20px, 5vw, 24px) 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 40px;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  nav a {
    font-weight: 800;
    text-decoration: none;
  }

  .small-print {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    color: var(--on-night-muted);
    font-size: 15px;
  }

  .content:not(.night) .small-print {
    padding-top: 16px;
    border-top: 1px solid var(--night-raised);
  }

  .night {
    padding-top: 64px;
    padding-bottom: 32px;
    gap: 40px;
  }

  .night nav {
    gap: 10px;
  }

  .night nav a {
    padding: 12px 18px;
    border-radius: 14px;
    background: var(--night-raised);
  }
</style>
