---
import type { ComponentProps } from 'astro/types';

import BiteCircle from './BiteCircle.astro';

type Props = {
  id: string;
  time: string;
  /** Bite's face in this hour. */
  bite: ComponentProps<typeof BiteCircle>['face'];
  title: string;
  text: string;
  /** This hour's background, text and time colours. */
  colors: { band: string; text: string; time: string };
  /** Puts the picture on the left. */
  flip?: boolean;
} & (
  | {
      /** A screenshot beside the text. */
      image: string;
      alt: string;
    }
  | {
      /** Without a screenshot, the slot goes there. */
      image?: never;
      alt?: never;
    }
);

const { id, time, bite, title, text, colors, image, alt, flip = false } = Astro.props;
---

<section
  id={id}
  style={`background: ${colors.band}; color: ${colors.text}; --time: ${colors.time}`}
  class:list={{ flip }}
>
  <div class="content">
    <div class="text">
      <div class="moment">
        <p class="hour-time time">{time}</p>
        <BiteCircle face={bite} size={112} imageWidth={124} />
      </div>
      <h2 class="hour-title">{title}</h2>
      <p>{text}</p>
      <slot name="after-text" />
    </div>
    <div class="aside">
      {
        image ? (
          <img class="screen" src={image} alt={alt} width="300" height="652" loading="lazy" />
        ) : (
          <slot />
        )
      }
    </div>
  </div>
</section>

<style>
  section {
    padding: 80px clamp(20px, 5vw, 72px);
    font-size: 20px;
    line-height: 1.4;
    font-weight: 700;
  }

  .content {
    max-width: 1136px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
  }

  .flip .content {
    flex-direction: row-reverse;
  }

  .text {
    flex: 1 1 420px;
    min-width: 0;
  }

  .moment {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .time {
    color: var(--time);
  }

  h2 {
    margin-bottom: 12px;
  }

  .aside {
    flex: 0 1 300px;
    min-width: 0;
    margin: 0 auto;
  }

  .aside:not(:has(.screen)) {
    flex: 1 1 360px;
    max-width: 460px;
  }

  .screen {
    width: 100%;
    height: auto;
    border-radius: 34px;
    transform: rotate(2deg);
  }

  .flip .screen {
    transform: rotate(-2deg);
  }
</style>
