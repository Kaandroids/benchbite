---
type Props = {
  id: string;
  time: string;
  /** Bite's face in this hour: the name of its picture. */
  bite: string;
  title: string;
  text: string;
  /** This hour's background, text and time colours. */
  colors: { band: string; text: string; time: string };
  /** A screenshot beside the text; without one, the slot goes there. */
  image?: string;
  alt?: string;
  /** Puts the picture on the left. */
  flip?: boolean;
};

const { id, time, bite, title, text, colors, image, alt, flip = false } = Astro.props;
---

<section
  id={id}
  style={`background: ${colors.band}; color: ${colors.text}; --time: ${colors.time}`}
  class:list={{ flip }}
>
  <div class="content">
    <div class="text">
      <div class="moment">
        <p class="time">{time}</p>
        <div class="bite">
          <img src={`/images/bite-${bite}.svg`} alt="" width="124" height="111" loading="lazy" />
        </div>
      </div>
      <h2>{title}</h2>
      <p>{text}</p>
      <slot name="after-text" />
    </div>
    <div class="aside">
      {
        image ? (
          <img class="screen" src={image} alt={alt} width="300" height="652" loading="lazy" />
        ) : (
          <slot />
        )
      }
    </div>
  </div>
</section>

<style>
  section {
    padding: 80px clamp(20px, 5vw, 72px);
    scroll-margin-top: 0;
    font-size: 20px;
    line-height: 1.4;
    font-weight: 700;
  }

  .content {
    max-width: 1136px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
  }

  .flip .content {
    flex-direction: row-reverse;
  }

  .text {
    flex: 1 1 420px;
    min-width: 0;
  }

  .moment {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .time {
    font-size: clamp(72px, 10vw, 136px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--time);
  }

  .bite {
    flex: none;
    width: 112px;
    height: 112px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--brand);
  }

  .bite img {
    max-width: none;
  }

  h2 {
    margin-bottom: 12px;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 900;
    line-height: 1.05;
  }

  .aside {
    flex: 0 1 300px;
    min-width: 0;
    margin: 0 auto;
  }

  .aside:not(:has(.screen)) {
    flex: 1 1 360px;
    max-width: 460px;
  }

  .screen {
    width: 100%;
    height: auto;
    border-radius: 34px;
    transform: rotate(2deg);
  }

  .flip .screen {
    transform: rotate(-2deg);
  }
</style>
