---
import Brand from './Brand.astro';
import { LOCALES, localePath, messagesFor, type Locale, type Page } from '../i18n';

type Props = {
  locale: Locale;
  page?: Page;
  /** On the brand's orange. */
  brand: boolean;
};

const { locale, page, brand } = Astro.props;
const messages = messagesFor(locale);
---

<header class:list={{ 'on-brand': brand }}>
  <div class="bar">
    <Brand locale={locale} iconSize={36} />
    <nav aria-label={messages.language}>
      {
        LOCALES.map((option) => (
          <a
            class:list={['language', { current: option === locale }]}
            href={localePath(option, page)}
            hreflang={option}
            aria-current={option === locale ? 'true' : undefined}
          >
            {option.toUpperCase()}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .on-brand {
    --text-muted: var(--on-inverse-muted);
    --track: var(--ink);
    --primary-text: var(--brand-light);
    --brand-hover: var(--ink);
    background: var(--brand);
    color: var(--on-inverse);
  }

  .on-brand .language.current:hover {
    color: var(--ink);
  }

  .bar {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  nav {
    display: flex;
    gap: 2px;
    padding: 3px;
    border-radius: 11px;
    background: var(--track);
    font-size: 13px;
    font-weight: 800;
  }

  .language {
    min-height: 32px;
    padding: 0 9px;
    display: flex;
    align-items: center;
    border-radius: 8px;
    color: var(--text-muted);
    text-decoration: none;
  }

  .language.current {
    background: var(--surface);
    color: var(--text);
  }
</style>
