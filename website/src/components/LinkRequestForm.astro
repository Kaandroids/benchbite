---
import { FUNCTIONS_URL } from '../functions';

type Props = {
  locale: string;
  /** The Edge Function the form posts to. */
  action: string;
  copy: {
    withoutApp: string;
    withoutAppText: string;
    emailLabel: string;
    emailPlaceholder: string;
    send: string;
    linkNote: string;
  };
};

const { locale, action, copy } = Astro.props;
---

<!-- The form that asks for a link by email, for those without the app; the slot holds more of its
     fields, as the consent of a withdrawal. -->
<section class="without-app" id="without-app">
  <div>
    <h2 class="section-title">{copy.withoutApp}</h2>
    <p>{copy.withoutAppText}</p>
  </div>
  <form method="post" action={`${FUNCTIONS_URL}/${action}`}>
    <input type="hidden" name="locale" value={locale} />
    <slot />
    <label class="field-label" for="email">{copy.emailLabel}</label>
    <div class="row">
      <input
        class="field"
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        maxlength="254"
        required
        placeholder={copy.emailPlaceholder}
      />
      <button class="button" type="submit">{copy.send}</button>
    </div>
  </form>
  <p class="muted link-note">{copy.linkNote}</p>
</section>

<style>
  .without-app {
    padding: 24px;
    border-radius: 24px;
    background: var(--lunch-background);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field-label {
    padding: 0;
    font-weight: 800;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .field {
    flex: 1 1 260px;
  }

  .link-note {
    font-size: 16px;
  }
</style>
