---
import BiteCircle from '../../components/BiteCircle.astro';
import Layout from '../../layouts/Layout.astro';
import { localePath, localeStaticPaths, messagesFor, type Locale } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = Astro.props.locale as Locale;
const { notFound } = messagesFor(locale);
---

<Layout locale={locale} title={notFound.title}>
  <main class="page not-found">
    <BiteCircle face="sad" size={200} imageWidth={178} alt={notFound.biteAlt} loading="eager" />
    <h1>{notFound.heading}</h1>
    <p class="muted">{notFound.text}</p>
    <a class="back" href={localePath(locale)}>{notFound.back}</a>
  </main>
</Layout>

<style>
  .not-found {
    max-width: 808px;
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  h1 {
    margin-top: 8px;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .back {
    margin-top: 8px;
    padding: 14px 24px;
    border-radius: 16px;
    background: var(--primary-button);
    box-shadow: 0 4px 0 var(--primary-button-ledge);
    color: var(--on-primary);
    font-weight: 800;
    text-decoration: none;
  }

  .back:hover {
    color: var(--on-primary);
  }
</style>
