---
import Layout from '../../layouts/Layout.astro';
import LinkRequestForm from '../../components/LinkRequestForm.astro';
import { localePath, localeStaticPaths, messagesFor, type Locale } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = Astro.props.locale as Locale;
const { withdrawConsent } = messagesFor(locale);
const consents = (['ai', 'health'] as const).map((consent) => ({
  consent,
  ...withdrawConsent.consents[consent],
}));
---

<Layout locale={locale} page="withdraw-consent" title={withdrawConsent.title}>
  <main class="page">
    <div>
      <h1>{withdrawConsent.title}</h1>
      <p class="muted lead">{withdrawConsent.text}</p>
    </div>
    <section class="card">
      <h2 class="section-title">{withdrawConsent.inApp}</h2>
      <ol>
        {withdrawConsent.steps.map((step) => <li>{step}</li>)}
      </ol>
      <p class="guest-note">{withdrawConsent.guestNote}</p>
    </section>
    <LinkRequestForm locale={locale} action="request-consent-withdrawal" copy={withdrawConsent}>
      <fieldset>
        <legend>{withdrawConsent.consentLabel}</legend>
        {
          consents.map(({ consent, title, text }, index) => (
            <label class="choice">
              <input type="radio" name="consent" value={consent} checked={index === 0} required />
              <span>
                {title}
                <small>{text}</small>
              </span>
            </label>
          ))
        }
      </fieldset>
    </LinkRequestForm>
    <p class="muted">
      {withdrawConsent.deleteInstead}{' '}
      <a class="text-link" href={localePath(locale, 'delete-account')}>
        {withdrawConsent.deleteLink}
      </a>
    </p>
  </main>
</Layout>

<style>
  ol {
    margin: 0;
    padding-left: 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  fieldset {
    margin: 0 0 8px;
    padding: 0;
    border: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  legend {
    padding: 0;
    font-weight: 800;
  }

  legend {
    margin-bottom: 8px;
  }

  .choice {
    padding: 12px 16px;
    border: 2px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-weight: 800;
    cursor: pointer;
  }

  .choice:has(input:checked) {
    border-color: var(--primary-button);
  }

  .choice input {
    margin: 6px 0 0;
    accent-color: var(--primary-button);
  }

  small {
    display: block;
    color: var(--text-muted);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
  }

  .guest-note {
    margin-top: 16px;
  }
</style>
