---
import Layout from '../../layouts/Layout.astro';
import { FUNCTIONS_URL } from '../../functions';
import { localePath, localeStaticPaths, messagesFor, type Locale } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = Astro.props.locale as Locale;
const { withdrawConsent } = messagesFor(locale);
const consents = (['ai', 'health'] as const).map((consent) => ({
  consent,
  ...withdrawConsent.consents[consent],
}));
---

<Layout locale={locale} page="withdraw-consent" title={withdrawConsent.title}>
  <main class="page">
    <div>
      <h1>{withdrawConsent.title}</h1>
      <p class="muted lead">{withdrawConsent.text}</p>
    </div>
    <section class="card">
      <h2 class="section-title">{withdrawConsent.inApp}</h2>
      <ol>
        {withdrawConsent.steps.map((step) => <li>{step}</li>)}
      </ol>
      <p class="guest-note">{withdrawConsent.guestNote}</p>
    </section>
    <section class="without-app" id="without-app">
      <div>
        <h2 class="section-title">{withdrawConsent.withoutApp}</h2>
        <p>{withdrawConsent.withoutAppText}</p>
      </div>
      <form method="post" action={`${FUNCTIONS_URL}/request-consent-withdrawal`}>
        <input type="hidden" name="locale" value={locale} />
        <fieldset>
          <legend>{withdrawConsent.consentLabel}</legend>
          {
            consents.map(({ consent, title, text }, index) => (
              <label class="choice">
                <input type="radio" name="consent" value={consent} checked={index === 0} required />
                <span>
                  {title}
                  <small>{text}</small>
                </span>
              </label>
            ))
          }
        </fieldset>
        <label class="field-label" for="email">{withdrawConsent.emailLabel}</label>
        <div class="row">
          <input
            class="field"
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            maxlength="254"
            required
            placeholder={withdrawConsent.emailPlaceholder}
          />
          <button class="button" type="submit">{withdrawConsent.send}</button>
        </div>
      </form>
      <p class="muted link-note">{withdrawConsent.linkNote}</p>
    </section>
    <p class="muted">
      {withdrawConsent.deleteInstead}{' '}
      <a class="text-link" href={localePath(locale, 'delete-account')}>
        {withdrawConsent.deleteLink}
      </a>
    </p>
  </main>
</Layout>

<style>
  ol {
    margin: 0;
    padding-left: 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .without-app {
    padding: 24px;
    border-radius: 24px;
    background: var(--lunch-background);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  fieldset {
    margin: 0 0 8px;
    padding: 0;
    border: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  legend,
  .field-label {
    padding: 0;
    font-weight: 800;
  }

  legend {
    margin-bottom: 8px;
  }

  .choice {
    padding: 12px 16px;
    border: 2px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-weight: 800;
    cursor: pointer;
  }

  .choice:has(input:checked) {
    border-color: var(--primary-button);
  }

  .choice input {
    margin: 6px 0 0;
    accent-color: var(--primary-button);
  }

  small {
    display: block;
    color: var(--text-muted);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .field {
    flex: 1 1 260px;
  }

  .link-note {
    font-size: 16px;
  }

  .guest-note {
    margin-top: 16px;
  }
</style>
