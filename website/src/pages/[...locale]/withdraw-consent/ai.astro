---
import Layout from '../../../layouts/Layout.astro';
import WithdrawConfirm from '../../../components/WithdrawConfirm.astro';
import { localeStaticPaths, messagesFor, type Locale } from '../../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = Astro.props.locale as Locale;
const { withdrawLink } = messagesFor(locale);
---

<!-- No page for the language links: they would open this page without its token. -->
<Layout locale={locale} title={withdrawLink.ai.title}>
  <WithdrawConfirm locale={locale} consent="ai" />
</Layout>
