---
import Layout from '../../../layouts/Layout.astro';
import { localePath, localeStaticPaths, messagesFor, type Locale } from '../../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = Astro.props.locale as Locale;
const { withdrawLink } = messagesFor(locale);
---

<Layout locale={locale} page="withdraw-consent/sent" title={withdrawLink.sentTitle}>
  <main class="page">
    <div>
      <h1>{withdrawLink.sentTitle}</h1>
      <p class="muted lead">{withdrawLink.sentText}</p>
    </div>
    <section class="card">
      <p>{withdrawLink.sentHow}</p>
      <p class="muted">{withdrawLink.sentNote}</p>
    </section>
    <a class="text-link link" href={`${localePath(locale, 'withdraw-consent')}#without-app`}>
      {withdrawLink.anotherEmail}
    </a>
  </main>
</Layout>

<style>
  .link {
    align-self: flex-start;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
</style>
