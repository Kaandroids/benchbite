---
import Layout from '../../../layouts/Layout.astro';
import { localePath, localeStaticPaths, messagesFor, type Locale } from '../../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = Astro.props.locale as Locale;
const { withdrawLink } = messagesFor(locale);
---

<Layout locale={locale} page="withdraw-consent/done" title={withdrawLink.doneTitle}>
  <main class="page">
    <div>
      <h1>{withdrawLink.doneTitle}</h1>
      <p class="muted lead">{withdrawLink.doneText}</p>
    </div>
    <section class="card">
      <p>{withdrawLink.doneNote}</p>
    </section>
    <a class="text-link link" href={localePath(locale)}>{withdrawLink.backToStart}</a>
  </main>
</Layout>

<style>
  .link {
    align-self: flex-start;
  }
</style>
