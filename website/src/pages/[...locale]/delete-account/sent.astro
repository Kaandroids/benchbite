---
import Layout from '../../../layouts/Layout.astro';
import { localePath, localeStaticPaths, messagesFor, type Locale } from '../../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = Astro.props.locale as Locale;
const { deleteLink } = messagesFor(locale);
---

<Layout locale={locale} page="delete-account/sent" title={deleteLink.sentTitle}>
  <main class="page">
    <div>
      <h1>{deleteLink.sentTitle}</h1>
      <p class="muted lead">{deleteLink.sentText}</p>
    </div>
    <section class="card">
      <p>{deleteLink.sentHow}</p>
      <p class="muted">{deleteLink.sentNote}</p>
    </section>
    <a class="text-link link" href={`${localePath(locale, 'delete-account')}#without-app`}>
      {deleteLink.anotherEmail}
    </a>
  </main>
</Layout>

<style>
  .link {
    align-self: flex-start;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
</style>
