---
import Layout from '../../../layouts/Layout.astro';
import LinkConfirm from '../../../components/LinkConfirm.astro';
import { localePath, localeStaticPaths, messagesFor, type Locale } from '../../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = Astro.props.locale as Locale;
const { deleteLink } = messagesFor(locale);
---

<!-- No page for the language links: they would open this page without its token. -->
<Layout locale={locale} title={deleteLink.confirmTitle}>
  <main class="page">
    <div>
      <h1>{deleteLink.confirmTitle}</h1>
      <p class="muted lead">{deleteLink.confirmText}</p>
    </div>
    <LinkConfirm
      locale={locale}
      action="confirm-account-deletion"
      confirm={deleteLink.delete}
      keep={{ label: deleteLink.keep, href: localePath(locale) }}
      failed={deleteLink.failed}
      noLink={deleteLink.noLink}
      askAgain={{
        label: deleteLink.askAgain,
        href: `${localePath(locale, 'delete-account')}#without-app`,
      }}
      noScript={deleteLink.noScript}
    >
      <section class="card">
        <ul>
          {deleteLink.items.map((item) => <li>{item}</li>)}
        </ul>
      </section>
      <p class="note">{deleteLink.subscription}</p>
    </LinkConfirm>
  </main>
</Layout>

<style>
  ul {
    margin: 0;
    padding-left: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
</style>
