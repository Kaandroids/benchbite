---
import Layout from '../../../layouts/Layout.astro';
import { localePath, localeStaticPaths, messagesFor, type Locale } from '../../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = Astro.props.locale as Locale;
const { deleteLink } = messagesFor(locale);
---

<Layout locale={locale} page="delete-account/done" title={deleteLink.doneTitle}>
  <main class="page">
    <div>
      <h1>{deleteLink.doneTitle}</h1>
      <p class="muted lead">{deleteLink.doneText}</p>
    </div>
    <section class="card">
      <p>{deleteLink.doneNote}</p>
    </section>
    <a class="text-link link" href={localePath(locale)}>{deleteLink.backToStart}</a>
  </main>
</Layout>

<style>
  .link {
    align-self: flex-start;
  }
</style>
