---
import LegalPage from '../../components/LegalPage.astro';
import { localeStaticPaths, messagesFor, type Locale } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = Astro.props.locale as Locale;
const { privacy } = messagesFor(locale);
---

<LegalPage locale={locale} page="privacy" title={privacy.title} sections={privacy.sections} />
