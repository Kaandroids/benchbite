---
import Layout from '../../../layouts/Layout.astro';
import LinkConfirm from '../../../components/LinkConfirm.astro';
import { localePath, localeStaticPaths, messagesFor, type Locale } from '../../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = Astro.props.locale as Locale;
const { exportLink } = messagesFor(locale);
---

<!-- No page for the language links: they would open this page without its token. -->
<Layout locale={locale} title={exportLink.downloadTitle}>
  <main class="page">
    <div>
      <h1>{exportLink.downloadTitle}</h1>
      <p class="muted lead">{exportLink.downloadText}</p>
    </div>
    <LinkConfirm
      locale={locale}
      action="download-data-export"
      confirm={exportLink.download}
      keep={{ label: exportLink.backToStart, href: localePath(locale) }}
      failed={exportLink.failed}
      noLink={exportLink.noLink}
      askAgain={{
        label: exportLink.askAgain,
        href: `${localePath(locale, 'export-data')}#without-app`,
      }}
      noScript={exportLink.noScript}
      download
    >
      <section class="card">
        <p>{exportLink.downloadNote}</p>
      </section>
      <p class="muted again">{exportLink.again}</p>
    </LinkConfirm>
  </main>
</Layout>

<style>
  .again {
    font-size: 16px;
  }
</style>
