---
import LinkExpired from '../../../components/LinkExpired.astro';
import { localeStaticPaths, messagesFor, type Locale } from '../../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = Astro.props.locale as Locale;
---

<LinkExpired
  locale={locale}
  page="export-data/expired"
  copy={messagesFor(locale).exportLink}
  requestPage="export-data"
/>
