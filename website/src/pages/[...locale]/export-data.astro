---
import Layout from '../../layouts/Layout.astro';
import LinkRequestForm from '../../components/LinkRequestForm.astro';
import { localeStaticPaths, messagesFor, type Locale } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = Astro.props.locale as Locale;
const { exportData } = messagesFor(locale);
---

<Layout locale={locale} page="export-data" title={exportData.title}>
  <main class="page">
    <div>
      <h1>{exportData.title}</h1>
      <p class="muted lead">{exportData.text}</p>
    </div>
    <section class="card">
      <h2 class="section-title">{exportData.inApp}</h2>
      <ol>
        {exportData.steps.map((step) => <li>{step}</li>)}
      </ol>
      <p class="guest-note">{exportData.guestNote}</p>
    </section>
    <LinkRequestForm locale={locale} action="request-data-export" copy={exportData} />
    <section>
      <h2 class="section-title">{exportData.holds}</h2>
      <p class="muted">{exportData.holdsText}</p>
    </section>
  </main>
</Layout>

<style>
  ol {
    margin: 0;
    padding-left: 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .guest-note {
    margin-top: 16px;
  }
</style>
