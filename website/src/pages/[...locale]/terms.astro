---
import LegalPage from '../../components/LegalPage.astro';
import { localeStaticPaths, messagesFor, type Locale } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = Astro.props.locale as Locale;
const { terms } = messagesFor(locale);
---

<LegalPage locale={locale} page="terms" title={terms.title} sections={terms.sections} />
