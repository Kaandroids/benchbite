---
import Layout from '../../layouts/Layout.astro';
import LinkRequestForm from '../../components/LinkRequestForm.astro';
import { localeStaticPaths, messagesFor, type Locale } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = Astro.props.locale as Locale;
const { deleteAccount } = messagesFor(locale);
---

<Layout locale={locale} page="delete-account" title={deleteAccount.title}>
  <main class="page">
    <div>
      <h1>{deleteAccount.title}</h1>
      <p class="muted lead">{deleteAccount.text}</p>
    </div>
    <section class="card">
      <h2 class="section-title">{deleteAccount.inApp}</h2>
      <ol>
        {deleteAccount.steps.map((step) => <li>{step}</li>)}
      </ol>
      <p class="guest-note">{deleteAccount.guestNote}</p>
    </section>
    <LinkRequestForm locale={locale} action="request-account-deletion" copy={deleteAccount} />
    <section>
      <h2 class="section-title">{deleteAccount.kept}</h2>
      <dl class="kept">
        {
          deleteAccount.keptItems.map(({ title, text }) => (
            <div>
              <dt>{title}</dt>
              <dd>{text}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </main>
</Layout>

<style>
  ol {
    margin: 0;
    padding-left: 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .kept {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  dt {
    font-weight: 800;
  }

  dd {
    margin: 0;
  }

  .guest-note {
    margin-top: 16px;
  }
</style>
