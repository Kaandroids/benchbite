---
import type { ComponentProps } from 'astro/types';

import DaySection from '../../components/DaySection.astro';
import Layout from '../../layouts/Layout.astro';
import { localeStaticPaths, messagesFor, type Locale } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = Astro.props.locale as Locale;
const { hero, day } = messagesFor(locale);

const INK = 'var(--ink)';

// The day's colours are the app's meal colours. The evening is the dark one, and lunch's time keeps
// the brand's orange text, as the meal's own orange is too light for it.
const plan = {
  id: 'plan',
  time: '06:45',
  navColor: 'var(--snack-on-dark)',
  colors: { band: 'var(--snack-background)', text: INK, time: 'var(--snack)' },
};

const screens: (Pick<ComponentProps<typeof DaySection>, 'id' | 'time' | 'bite' | 'colors' | 'flip'> & {
  navColor: string;
  copy: { nav: string; title: string; text: string; alt: string };
  image: string;
})[] = [
  {
    id: 'breakfast',
    time: '07:30',
    bite: 'neutral',
    navColor: 'var(--breakfast-on-dark)',
    colors: { band: 'var(--breakfast-background)', text: INK, time: 'var(--breakfast)' },
    copy: day.breakfast,
    image: '/images/nutrition.png',
  },
  {
    id: 'lunch',
    time: '12:30',
    bite: 'thinking',
    navColor: 'var(--lunch-on-dark)',
    colors: { band: 'var(--lunch-background)', text: INK, time: 'var(--primary-text)' },
    copy: day.lunch,
    image: '/images/bite.png',
    flip: true,
  },
  {
    id: 'workout',
    time: '18:00',
    bite: 'surprised',
    navColor: 'var(--water-on-dark)',
    colors: { band: INK, text: 'var(--on-inverse)', time: 'var(--water-on-dark)' },
    copy: day.workout,
    image: '/images/workout-active.png',
  },
  {
    id: 'progress',
    time: '22:00',
    bite: 'happy',
    navColor: 'var(--dinner-on-dark)',
    colors: { band: 'var(--dinner-background)', text: INK, time: 'var(--dinner)' },
    copy: day.progress,
    image: '/images/progress.png',
    flip: true,
  },
];

const hours = [
  { ...plan, nav: day.plan.nav },
  ...screens.map((hour) => ({ id: hour.id, time: hour.time, navColor: hour.navColor, nav: hour.copy.nav })),
];
---

<Layout locale={locale} brandHeader nightFooter>
  <main>
    <section class="hero">
      <div class="hero-content">
        <div class="hero-text">
          <h1>{hero.title.map((part) => <span>{part}</span>)}</h1>
          <p class="intro">{hero.text}</p>
          <p class="soon">{hero.soon}</p>
        </div>
        <div class="hero-bite">
          <p class="bubble">{hero.greeting}<br />{hero.promise}</p>
          <img src="/images/bite-happy.svg" alt={hero.biteAlt} width="760" height="679" />
        </div>
      </div>
    </section>

    <nav class="hours" aria-label={day.label}>
      {
        hours.map((hour) => (
          <a href={`#${hour.id}`}>
            <span style={`color: ${hour.navColor}`}>{hour.time}</span> {hour.nav}
          </a>
        ))
      }
    </nav>

    <DaySection
      id={plan.id}
      time={plan.time}
      bite="thinking"
      title={day.plan.title}
      text={day.plan.text}
      colors={plan.colors}
    >
      <ul class="chips" slot="after-text">
        {day.plan.chips.map((chip) => <li>{chip}</li>)}
      </ul>
      <div class="chat">
        <p class="you">{day.plan.you}</p>
        <p class="reply">{day.plan.bite}</p>
        <div class="proposal">
          <strong>{day.plan.cardTitle}</strong>
          <span class="meta">{day.plan.cardMeta}</span>
          <div class="actions">
            <span class="add">{day.plan.cardAdd}</span>
            <span class="edit">{day.plan.cardEdit}</span>
          </div>
        </div>
      </div>
    </DaySection>

    {
      screens.map((hour) => (
        <DaySection
          id={hour.id}
          time={hour.time}
          bite={hour.bite}
          title={hour.copy.title}
          text={hour.copy.text}
          colors={hour.colors}
          image={hour.image}
          alt={hour.copy.alt}
          flip={hour.flip}
        />
      ))
    }
  </main>
</Layout>

<style>
  main {
    flex-grow: 1;
    width: 100%;
    overflow: hidden;
  }

  .hero {
    overflow: hidden;
    padding: 0 clamp(20px, 5vw, 72px);
    background: var(--brand);
    color: var(--ink);
  }

  .hero-content {
    max-width: 1136px;
    margin: 0 auto;
    padding-top: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 16px;
  }

  .hero-text {
    flex: 1 1 680px;
    min-width: 0;
    padding-bottom: 88px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  h1 {
    font-size: clamp(46px, 7.6vw, 104px);
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: var(--on-inverse);
  }

  h1 span {
    display: block;
  }

  .intro {
    max-width: 480px;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.35;
  }

  .soon {
    padding: 14px 22px;
    border-radius: 16px;
    background: var(--ink);
    color: var(--on-inverse);
    font-weight: 800;
  }

  .hero-bite {
    flex: 1 1 400px;
    min-width: 0;
    position: relative;
    display: flex;
    justify-content: center;
  }

  .hero-bite img {
    width: 125%;
    max-width: 760px;
    height: auto;
    margin-bottom: -16%;
  }

  .bubble {
    position: absolute;
    bottom: calc(100% - 16px);
    left: 0;
    z-index: 1;
    padding: 14px 20px;
    border-radius: 22px 22px 22px 4px;
    background: var(--surface);
    font-size: 21px;
    font-weight: 900;
    line-height: 1.2;
  }

  .hours {
    padding: 18px 20px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px clamp(20px, 4vw, 56px);
    background: var(--ink);
    font-size: clamp(18px, 2.2vw, 26px);
    font-weight: 900;
  }

  .hours a {
    color: var(--on-inverse);
    text-decoration: none;
  }

  .chips {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chips li {
    padding: 8px 14px;
    border-radius: 12px;
    background: var(--surface);
    font-size: 17px;
    font-weight: 800;
  }

  .chat {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 18px;
    line-height: 1.32;
  }

  .you,
  .reply {
    max-width: 85%;
    padding: 14px 18px;
  }

  .you {
    align-self: flex-end;
    border-radius: 22px 22px 6px 22px;
    background: var(--ink);
    color: var(--on-inverse);
  }

  .reply {
    align-self: flex-start;
    border-radius: 22px 22px 22px 6px;
    background: var(--surface);
  }

  .proposal {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-radius: 24px;
    background: var(--surface);
    border: 2px solid var(--border);
  }

  .proposal strong {
    font-size: 22px;
    font-weight: 900;
    line-height: 1.2;
  }

  .meta {
    color: var(--text-muted);
  }

  .actions {
    padding-top: 6px;
    display: flex;
    gap: 10px;
  }

  .add,
  .edit {
    padding: 12px 18px;
    border-radius: 14px;
    font-weight: 800;
    text-align: center;
  }

  .add {
    flex-grow: 1;
    background: var(--primary-button);
    box-shadow: 0 3px 0 var(--primary-button-ledge);
    color: var(--on-primary);
  }

  .edit {
    border: 2px solid var(--border);
  }
</style>
