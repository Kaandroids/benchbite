# Secrets of the Edge Functions when they run locally. Copy to .env, which Git ignores.
# The hosted project keeps them in the dashboard: Edge Functions → Secrets.

# studio: the Gemini Developer API with an API key from https://aistudio.google.com/apikey, for
# test data only.
GEMINI_BACKEND=studio
GEMINI_API_KEY=your-gemini-api-key
# vertex: Vertex AI in the EU, as the hosted project calls it (ADR 0153), with the key file of a
# Google Cloud service account that has the Vertex AI User role, as base64 on one line:
# base64 -i key.json | tr -d '\n'
# GEMINI_BACKEND=vertex
# VERTEX_SERVICE_ACCOUNT=

# Sending email from Edge Functions (ADR 0094). The hosted project uses Lettermint's API with a
# project token; locally, Mailpit takes the email instead, and the links point at the local site.
# LETTERMINT_API_TOKEN=
MAILPIT_URL=http://supabase_inbucket_benchbite:8025
SITE_URL=http://localhost:4321

# The address the phone and the browser reach the local Supabase at, for the links to exported data
# (ADR 0169): the functions sign with Docker's own. On a phone, your computer's address on the
# network, as EXPO_PUBLIC_SUPABASE_URL. The hosted project sets none.
STORAGE_PUBLIC_URL=http://127.0.0.1:54321
