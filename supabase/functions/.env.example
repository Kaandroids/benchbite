# Secrets of the Edge Functions when they run locally. Copy to .env, which Git ignores.
# The hosted project keeps them in the dashboard: Edge Functions → Secrets.

# studio: the Gemini Developer API with an API key from https://aistudio.google.com/apikey
GEMINI_BACKEND=studio
GEMINI_API_KEY=your-gemini-api-key

# Sending email from Edge Functions (ADR 0094). The hosted project uses Lettermint's API with a
# project token; locally, Mailpit takes the email instead, and the links point at the local site.
# LETTERMINT_API_TOKEN=
MAILPIT_URL=http://supabase_inbucket_benchbite:8025
SITE_URL=http://localhost:4321
